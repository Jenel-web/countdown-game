# Web app (Next.js / Vercel). Placeholders only: this is the only .env file that
# belongs in git. Copy to .env.local for local development.
#
# PRODUCTION: do NOT put real values in a file. Set them in the Vercel project
# settings (Settings > Environment Variables, Production and Preview).
# NEXT_PUBLIC_ values are sent to every visitor and are fixed when the site is
# BUILT: change one, then redeploy.
#
# Never put the service role / secret key in this file or in any NEXT_PUBLIC_
# variable: the build refuses it (config/checkWebEnv.js).

# Supabase project address (Project Settings > API). Must be https.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co

# The public anon / publishable key (Project Settings > API). NOT the service role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Address of the game server (countdown-server).
#   local:       http://localhost:4000
#   production:  its public https address, e.g. https://your-game-server.onrender.com
#                (no trailing slash; if it is missing the client falls back to localhost)
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Optional. Set to true to ENFORCE the strict Content-Security-Policy (it is
# report-only by default; see config/securityHeaders.js). Turn on in production
# only after the staging console shows no "[Report Only] Refused to ..." messages.
# CSP_ENFORCE=false

# Optional. Makes `npm run build` fail on a missing/invalid variable even outside
# Vercel (it is always strict on Vercel). Useful for a production-like local build.
# CHECK_ENV_STRICT=true
