# Web app (Next.js / Vercel). Copy to .env.local for local development, or set
# these in the Vercel project settings. NEXT_PUBLIC_ values are sent to every
# visitor and are fixed when the site is BUILT: change one, then redeploy.
#
# Never put the service role / secret key in this file or in any NEXT_PUBLIC_
# variable: the build refuses it (config/checkWebEnv.js).

# Supabase project address (Project Settings > API). Must be https.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co

# The public anon / publishable key (Project Settings > API). NOT the service role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Address of the game server (countdown-server). Local: http://localhost:4000
# Deployed: its public https address, e.g. https://your-game-server.onrender.com
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Optional. Set to true to ENFORCE the strict Content-Security-Policy (it is
# report-only by default; see config/securityHeaders.js).
# CSP_ENFORCE=false
