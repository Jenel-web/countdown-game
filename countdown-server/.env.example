# Game server (Node / Render, Railway or Fly). Placeholders only: this is the ONLY
# .env file that belongs in git. Copy to countdown-server/.env for local development.
#
# PRODUCTION: do NOT put real values in a file. Set them in the host's environment
# settings (Render > Environment, Railway > Variables, `fly secrets set`).

# Supabase project address and the SERVICE ROLE key. The service role key bypasses
# all database security: keep it on this server only, never in the web app, never
# in git.
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Website address(es) allowed to connect, comma separated, exact origin, no trailing
# path or slash, never "*". REQUIRED in production (the server refuses to start
# without it).
#   local:       http://localhost:3000
#   production:  https://your-site.vercel.app
#                (list the apex and www both if both serve the site)
ALLOWED_ORIGIN=http://localhost:3000

# Set to true when the server sits behind exactly ONE reverse proxy (Render,
# Railway and Fly all do). Left unset there, every player shares one
# connection-rate limit and a few users can lock out everyone.
#   local:       false (players connect directly)
#   production:  true
TRUST_PROXY=false

# Optional. Defaults to 4000. Render and Railway set PORT for you; leave it unset there.
# PORT=4000

# Optional. Render, Railway and Fly set these (or NODE_ENV) themselves and the
# server then switches to production checks. Set it yourself on any other host.
# NODE_ENV=production
