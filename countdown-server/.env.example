# Game server (Node / Render, Railway or Fly). Copy to countdown-server/.env for
# local development, or set these in the host's environment settings.
# This file is the ONLY .env file that belongs in git, and it holds placeholders only.

# Supabase project address and the SERVICE ROLE key. The service role key bypasses
# all database security: keep it on this server only, never in the web app.
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Website address(es) allowed to connect, comma separated, no trailing path.
# REQUIRED in production (the server refuses to start without it).
#   local:      http://localhost:3000
#   deployed:   https://your-site.vercel.app
ALLOWED_ORIGIN=http://localhost:3000

# Set to true when the server sits behind exactly ONE reverse proxy (Render,
# Railway and Fly all do). Left unset there, every player shares one
# connection-rate limit and a few users can lock out everyone.
# Leave false when players connect to the server directly (local development).
TRUST_PROXY=false

# Optional. Defaults to 4000. Render and Railway set PORT for you.
# PORT=4000
